
#include <stdio.h>

int main() {
    int n;
    printf("Enter array size: ");
    scanf("%d", &n);

    int a[n], dp[n];
    printf("Enter positive elements: ");
    for (int i = 0; i < n; i++) {
        scanf("%d", &a[i]);
        dp[i] = a[i];
    }

    int ans = a[0];

    for (int i = 1; i < n; i++) {
        for (int j = 0; j < i; j++) {
            if (a[j] < a[i] &&
                dp[j] + a[i] > dp[i])
                dp[i] = dp[j] + a[i];
        }
        if (dp[i] > ans)
            ans = dp[i];
    }

    printf("Maximum sum = %d\n", ans);
    return 0;
}
