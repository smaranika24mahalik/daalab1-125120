#include <stdio.h>
#include <stdlib.h>

int parent[1005], rank[1005], parity[1005];

int find(int x)
{
    if (parent[x] != x)
    {
        int p = parent[x];
        parent[x] = find(parent[x]);
        parity[x] ^= parity[p];
    }
    return parent[x];
}

int unite(int u, int v)
{
    int ru = find(u);
    int rv = find(v);

    if (ru == rv)
        return (parity[u] ^ parity[v]) == 1;

    if (rank[ru] < rank[rv])
    {
        parent[ru] = rv;
        parity[ru] = parity[u] ^ parity[v] ^ 1;
    }
    else
    {
        parent[rv] = ru;
        parity[rv] = parity[u] ^ parity[v] ^ 1;

        if (rank[ru] == rank[rv])
            rank[ru]++;
    }

    return 1;
}

int main()
{
    int V, E, u, v;

    scanf("%d %d", &V, &E);

    for (int i = 1; i <= V; i++)
    {
        parent[i] = i;
        rank[i] = 0;
        parity[i] = 0;
    }

    for (int i = 0; i < E; i++)
    {
        scanf("%d %d", &u, &v);

        if (unite(u, v))
            printf("Edge accepted\n");
        else
            printf("Edge rejected: Graph is not bipartite\n");
    }

    return 0;
}