#include <stdio.h>
#include <limits.h>

#define MAX 10005

int parent[MAX], size[MAX];

long long weight[MAX], sum[MAX];

int find(int x)
{
    if (parent[x] != x)
        parent[x] = find(parent[x]);

    return parent[x];
}

void unite(int u, int v, int K)
{
    int ru = find(u);
    int rv = find(v);

    if (ru == rv)
        return;

    if (size[ru] < size[rv])
    {
        int temp = ru;
        ru = rv;
        rv = temp;
    }

    parent[rv] = ru;
    size[ru] += size[rv];
    sum[ru] += sum[rv];
}

int main()
{
    int n, m, K;
    int u, v;

    scanf("%d %d %d", &n, &m, &K);

    for (int i = 1; i <= n; i++)
    {
        scanf("%lld", &weight[i]);

        parent[i] = i;
        size[i] = 1;
        sum[i] = weight[i];
    }

    for (int i = 0; i < m; i++)
    {
        scanf("%d %d", &u, &v);

        unite(u, v, K);

        long long ans = LLONG_MIN;

        for (int j = 1; j <= n; j++)
        {
            if (parent[j] == j && size[j] <= K)
            {
                if (sum[j] > ans)
                    ans = sum[j];
            }
        }

        if (ans == LLONG_MIN)
            printf("No valid component\n");
        else
            printf("%lld\n", ans);
    }

    return 0;
}