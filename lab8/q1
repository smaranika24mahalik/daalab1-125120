
#include <stdio.h>
#include <limits.h>

int main() {
    int n, V;
    printf("Enter number of coins: ");
    scanf("%d", &n);

    int c[n];
    printf("Enter coin denominations: ");
    for (int i = 0; i < n; i++)
        scanf("%d", &c[i]);

    printf("Enter target amount: ");
    scanf("%d", &V);

    int dp[V + 1];
    dp[0] = 0;

    for (int i = 1; i <= V; i++)
        dp[i] = INT_MAX / 2;

    for (int i = 1; i <= V; i++) {
        for (int j = 0; j < n; j++) {
            if (c[j] <= i)
                if (dp[i - c[j]] + 1 < dp[i])
                    dp[i] = dp[i - c[j]] + 1;
        }
    }

    if (dp[V] >= INT_MAX / 2)
        printf("Not possible\n");
    else
        printf("Minimum coins = %d\n", dp[V]);

    return 0;
}
